<?xml version="1.0"?>
<package format="2">
  <name>gazebo_sim_visualization</name>
  <version>0.1.0</version>
  <description>Gazebo Classic adapter for reusable XGC2 RViz and Lichtblick robot visualizers.</description>

  <maintainer email="lxk@example.com">lxk</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>foxglove_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>xgc2_robot_visualization</depend>

  <exec_depend>roslaunch</exec_depend>
  <exec_depend>rviz</exec_depend>

  <test_depend>roslaunch</test_depend>

  <export/>
</package>
