<launch>
  <arg name="frame_id" default="world"/>
  <arg name="model_states_topic" default="/gazebo/model_states"/>
  <arg name="vrpn_pose_prefix" default="/vrpn_client_node"/>
  <arg name="tracked_uav_models" default=""/>
  <arg name="allow_auto_discovery" default="true"/>
  <arg name="track_ugv" default="true"/>
  <arg name="publish_markers" default="true"/>
  <arg name="publish_transforms" default="true"/>
  <arg name="publish_scene_update" default="false"/>
  <arg name="scene_update_topic" default="/xgc/scene"/>
  <arg name="publish_rate" default="30.0"/>
  <arg name="scene_publish_rate" default="10.0"/>
  <arg name="scene_path_publish_rate" default="2.0"/>
  <arg name="path_publish_rate" default="10.0"/>
  <arg name="path_history_duration" default="15.0"/>
  <arg name="path_limit" default="3000"/>
  <arg name="vrpn_timeout" default="0.5"/>
  <arg name="joint_state_timeout" default="0.5"/>
  <arg name="mavros_state_timeout" default="2.0"/>
  <arg name="mavros_state_topic_suffix" default="/mavros/state"/>
  <arg name="rotor_speed_rad_s" default="70.0"/>
  <arg name="ugv_motion_timeout" default="0.5"/>
  <arg name="ugv_cmd_vel_topic_suffix" default="/cmd_vel"/>
  <arg name="ugv_twist_topic_suffix" default="/twist"/>
  <arg name="ugv_visual_wheel_radius" default="0.08"/>
  <arg name="ugv_visual_track_width" default="0.416"/>
  <arg name="ugv_wheel_motion_deadband" default="0.02"/>
  <arg name="ugv_max_visual_wheel_speed_rad_s" default="35.0"/>
  <arg name="rviz" default="true"/>
  <arg name="rviz_config" default="$(find gazebo_sim_visualization)/rviz/gazebo_auto_visualization.rviz"/>

  <group ns="gazebo_sim_visualization">
    <node pkg="gazebo_sim_visualization"
          type="gazebo_auto_visualizer_node"
          name="auto_visualizer"
          output="screen">
      <param name="frame_id" value="$(arg frame_id)"/>
      <param name="model_states_topic" value="$(arg model_states_topic)"/>
      <param name="vrpn_pose_prefix" value="$(arg vrpn_pose_prefix)"/>
      <param name="tracked_uav_models" value="$(arg tracked_uav_models)"/>
      <param name="allow_auto_discovery" value="$(arg allow_auto_discovery)"/>
      <param name="track_ugv" value="$(arg track_ugv)"/>
      <param name="publish_markers" value="$(arg publish_markers)"/>
      <param name="publish_transforms" value="$(arg publish_transforms)"/>
      <param name="publish_scene_update" value="$(arg publish_scene_update)"/>
      <param name="scene_update_topic" value="$(arg scene_update_topic)"/>
      <param name="publish_rate" value="$(arg publish_rate)"/>
      <param name="scene_publish_rate" value="$(arg scene_publish_rate)"/>
      <param name="scene_path_publish_rate" value="$(arg scene_path_publish_rate)"/>
      <param name="path_publish_rate" value="$(arg path_publish_rate)"/>
      <param name="path_history_duration" value="$(arg path_history_duration)"/>
      <param name="path_limit" value="$(arg path_limit)"/>
      <param name="vrpn_timeout" value="$(arg vrpn_timeout)"/>
      <param name="joint_state_timeout" value="$(arg joint_state_timeout)"/>
      <param name="mavros_state_timeout" value="$(arg mavros_state_timeout)"/>
      <param name="mavros_state_topic_suffix" value="$(arg mavros_state_topic_suffix)"/>
      <param name="rotor_speed_rad_s" value="$(arg rotor_speed_rad_s)"/>
      <param name="ugv_motion_timeout" value="$(arg ugv_motion_timeout)"/>
      <param name="ugv_cmd_vel_topic_suffix" value="$(arg ugv_cmd_vel_topic_suffix)"/>
      <param name="ugv_twist_topic_suffix" value="$(arg ugv_twist_topic_suffix)"/>
      <param name="ugv_visual_wheel_radius" value="$(arg ugv_visual_wheel_radius)"/>
      <param name="ugv_visual_track_width" value="$(arg ugv_visual_track_width)"/>
      <param name="ugv_wheel_motion_deadband" value="$(arg ugv_wheel_motion_deadband)"/>
      <param name="ugv_max_visual_wheel_speed_rad_s" value="$(arg ugv_max_visual_wheel_speed_rad_s)"/>
    </node>
  </group>

  <node if="$(arg rviz)"
        pkg="rviz"
        type="rviz"
        name="gazebo_auto_rviz"
        args="-d $(arg rviz_config)"
        output="screen"/>
</launch>
