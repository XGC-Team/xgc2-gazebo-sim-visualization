{
  "apiVersion": "xgc.execution.process/v1",
  "definitions": [
    {
      "id": "lichtblick-px4-scene",
      "version": "1.3.0",
      "label": "Lichtblick PX4 scene publisher",
      "description": "Internal run-aware publisher for PX4 multirotor models and actual path history using foxglove_msgs/SceneUpdate.",
      "drivers": [
        "host"
      ],
      "parameters": {
        "properties": {
          "robotModels": {
            "type": "string",
            "description": "Comma-separated Gazebo/VRPN model names derived from the immutable Swarm Asset snapshot",
            "default": ""
          },
          "rosMasterPort": {
            "type": "integer",
            "description": "Existing ROS 1 master port",
            "default": 11311,
            "minimum": 1,
            "maximum": 65535
          }
        },
        "additionalProperties": false
      },
      "resourceClaims": [
        {
          "bindingKey": "node",
          "kind": "custom",
          "mode": "",
          "capacity": 0,
          "namespace": "ros-node",
          "identityParts": [
            {
              "parameter": "rosMasterPort"
            },
            {
              "literal": "/xgc2_lichtblick_px4_scene"
            }
          ]
        }
      ],
      "command": {
        "executable": "/opt/ros/noetic/lib/gazebo_sim_visualization/gazebo_auto_visualizer_node",
        "args": [
          "__name:=xgc2_lichtblick_px4_scene",
          "_frame_id:=world",
          "_model_states_topic:=/gazebo/model_states",
          "_vrpn_pose_prefix:=/vrpn_client_node",
          "_tracked_uav_models:=${robotModels}",
          "_allow_auto_discovery:=false",
          "_track_ugv:=false",
          "_publish_markers:=false",
          "_publish_transforms:=false",
          "_publish_scene_update:=true",
          "_scene_update_topic:=/xgc/scene"
        ],
        "env": {
          "CMAKE_PREFIX_PATH": "/opt/ros/noetic",
          "LD_LIBRARY_PATH": "/opt/ros/noetic/lib:/opt/ros/noetic/lib/x86_64-linux-gnu:/opt/ros/noetic/lib/aarch64-linux-gnu",
          "PATH": "/opt/ros/noetic/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
          "PKG_CONFIG_PATH": "/opt/ros/noetic/lib/pkgconfig",
          "PYTHONPATH": "/opt/ros/noetic/lib/python3/dist-packages",
          "ROS_DISTRO": "noetic",
          "ROS_ETC_DIR": "/opt/ros/noetic/etc/ros",
          "ROS_MASTER_URI": "http://127.0.0.1:${rosMasterPort}",
          "ROS_PACKAGE_PATH": "/opt/ros/noetic/share",
          "ROS_PYTHON_VERSION": "3",
          "ROS_ROOT": "/opt/ros/noetic/share/ros",
          "ROS_VERSION": "1"
        }
      },
      "readiness": {
        "kind": "exec",
        "command": {
          "executable": "/opt/ros/noetic/bin/rostopic",
          "args": [
            "info",
            "/xgc/scene"
          ],
          "env": {
            "CMAKE_PREFIX_PATH": "/opt/ros/noetic",
            "LD_LIBRARY_PATH": "/opt/ros/noetic/lib:/opt/ros/noetic/lib/x86_64-linux-gnu:/opt/ros/noetic/lib/aarch64-linux-gnu",
            "PATH": "/opt/ros/noetic/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
            "PKG_CONFIG_PATH": "/opt/ros/noetic/lib/pkgconfig",
            "PYTHONPATH": "/opt/ros/noetic/lib/python3/dist-packages",
            "ROS_DISTRO": "noetic",
            "ROS_ETC_DIR": "/opt/ros/noetic/etc/ros",
            "ROS_MASTER_URI": "http://127.0.0.1:${rosMasterPort}",
            "ROS_PACKAGE_PATH": "/opt/ros/noetic/share",
            "ROS_PYTHON_VERSION": "3",
            "ROS_ROOT": "/opt/ros/noetic/share/ros",
            "ROS_VERSION": "1"
          }
        },
        "interval": 2000000000,
        "timeout": 2000000000,
        "successThreshold": 1,
        "failureThreshold": 5
      },
      "liveness": {
        "kind": "exec",
        "command": {
          "executable": "/opt/ros/noetic/bin/rosnode",
          "args": [
            "info",
            "/xgc2_lichtblick_px4_scene"
          ],
          "env": {
            "CMAKE_PREFIX_PATH": "/opt/ros/noetic",
            "LD_LIBRARY_PATH": "/opt/ros/noetic/lib:/opt/ros/noetic/lib/x86_64-linux-gnu:/opt/ros/noetic/lib/aarch64-linux-gnu",
            "PATH": "/opt/ros/noetic/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
            "PKG_CONFIG_PATH": "/opt/ros/noetic/lib/pkgconfig",
            "PYTHONPATH": "/opt/ros/noetic/lib/python3/dist-packages",
            "ROS_DISTRO": "noetic",
            "ROS_ETC_DIR": "/opt/ros/noetic/etc/ros",
            "ROS_MASTER_URI": "http://127.0.0.1:${rosMasterPort}",
            "ROS_PACKAGE_PATH": "/opt/ros/noetic/share",
            "ROS_PYTHON_VERSION": "3",
            "ROS_ROOT": "/opt/ros/noetic/share/ros",
            "ROS_VERSION": "1"
          }
        },
        "interval": 1000000000,
        "timeout": 2000000000,
        "successThreshold": 1,
        "failureThreshold": 3
      },
      "stop": {
        "gracePeriod": 5000000000
      },
      "restart": {
        "mode": "never",
        "maxRestarts": 0,
        "backoff": 0
      },
      "digest": "",
      "internal": true
    }
  ]
}
